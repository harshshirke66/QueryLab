# Database: Neon Serverless PostgreSQL
# Pooled connection string for serverless application queries
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct connection string for Prisma migrations & schema push
DIRECT_URL="postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Groq API for AI Question Generator, Hints, Explanations & Mock Interviewer
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Upstash Redis for Caching and Rate Limiting
UPSTASH_REDIS_REST_URL="https://sample-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# Authentication (Better Auth / Session Secret)
BETTER_AUTH_SECRET="querylab_super_secret_session_encryption_key_32chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
